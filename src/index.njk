<div class="info-section recent-research">
  <h2 class="section-label">Recent research</h2>
  <div class="recent-research-grid">
    {% for pub in recentResearch %}
    <div class="pub-entry recent-research-card">
      <div class="pub-toggle" aria-expanded="false">
        <span class="pub-toggle-icon"></span>
        <div class="pub-toggle-body">
          <span class="pub-title">
            {% if pub.url %}<a href="{{ pub.url }}" target="_blank" rel="noopener" onclick="event.stopPropagation()">{{ pub.title }}</a>{% else %}{{ pub.title }}{% endif %}
          </span>
          {#- "Report" covers country reports, policy briefs, and institutional
              reports, so name the specific one — same rule as /research/. -#}
          <div class="recent-research-meta">
            {%- if pub.type == "Report" -%}
              {%- if "Policy Brief" in pub.publication -%}Policy Brief
              {%- elif "Country Report" in pub.title -%}Country Report
              {%- else -%}Report{%- endif -%}
            {%- else -%}{{ pub.type }}{%- endif %} · {{ pub.year }}
          </div>
        </div>
      </div>
      <div class="pub-details">
        <div class="pub-details-inner">
          {% if pub.authors %}<div class="pub-authors">With: {{ pub.authors }}</div>{% endif %}
          <div class="pub-venue">{{ pub.publication }}</div>
          {% if pub.abstract %}<div class="pub-description">{{ pub.abstract | linkify | safe }}</div>{% endif %}
          {% if pub.extras %}<div class="pub-description"><em>{{ pub.extras | linkify | safe }}</em></div>{% endif %}
          <div class="citation-box">
            <div class="citation-text" id="cite-recent-{{ loop.index0 }}">{{ pub.citation | linkify | safe }}</div>
            <div class="citation-buttons">
              <button class="citation-copy" data-cite-id="cite-recent-{{ loop.index0 }}" data-format="plain" aria-label="Copy citation">Copy Citation</button>
              <button class="citation-copy" data-bibtex='{"authors":"{{ pub.citation.split(".")[0] | replace("'", "") }}","title":"{{ pub.title | replace("'", "") }}","year":"{{ pub.year }}","venue":"{{ pub.publication | replace("'", "") }}","url":"{{ pub.url or "" }}"}' data-format="bibtex" aria-label="Copy BibTeX">BibTeX</button>
            </div>
          </div>
        </div>
      </div>
    </div>
    {% endfor %}
  </div>
  <p class="recent-research-more"><a href="/research/">Browse all publications on the Research page →</a></p>
</div>
