{% from "link-icons.njk" import linkIcon %}

{#- The leading divider lives in base.njk (and, for the home page, in index.njk),
    so each caller controls its own spacing. -#}
<div class="info-section compact-section">
  {#- No "Links" label on the home page: the bio's closing line already says the
      links follow, so the rule leads straight into CV/Profile and its siblings. -#}
  {% if not linksFirst %}<span class="section-label">Links</span>{% endif %}
  <div class="info-grid info-grid-3col footer-link-grid">
    <div class="info-block">
      <h2>CV/Profile</h2>
      <ul class="info-list icon-list">
        <li><a href="https://www.wider.unu.edu/sites/default/files/expert_cv/CV_Jesse_Lastunen_June_2026_dd13ac139543b4b522bb2ade5b97429d.pdf">{{ linkIcon("cv") }}<span>CV</span></a></li>
        <li><a href="https://orcid.org/0000-0001-6241-7504">{{ linkIcon("orcid") }}<span>ORCID</span></a></li>
        <li><a href="https://www.wider.unu.edu/expert/jesse-lastunen">{{ linkIcon("profile") }}<span><span class="wide-only">UNU-WIDER profile</span><span class="narrow-only">Profile</span></span></a></li>
      </ul>
    </div>
    <div class="info-block">
      <h2>Publications</h2>
      <ul class="info-list icon-list">
        <li><a href="https://scholar.google.com/citations?user=TGdgvgIAAAAJ&hl=en">{{ linkIcon("scholar") }}<span>Google Scholar</span></a></li>
        <li><a href="https://www.rand.org/pubs/authors/l/lastunen_jesse.html">{{ linkIcon("rand") }}<span>RAND Publications</span></a></li>
        {#- The glyph goes inside the first link, not beside the pair: outside an
            <a> it had its own colour, ignored hover, and wasn't clickable. -#}
        <li><a href="https://econpapers.repec.org/RAS/pla1105.htm">{{ linkIcon("repec") }}<span>EconPapers</span></a> &amp; <a href="https://ideas.repec.org/f/pla1105.html">IDEAS</a></li>
      </ul>
    </div>
    <div class="info-block">
      <h2>Follow</h2>
      <ul class="info-list icon-list">
        <li><a href="https://github.com/jesselas">{{ linkIcon("github") }}<span>GitHub</span></a></li>
        <li><a href="https://www.linkedin.com/in/lastunen/">{{ linkIcon("linkedin") }}<span>LinkedIn</span></a></li>
        <li><a href="https://twitter.com/jesselastunen">{{ linkIcon("twitter") }}<span>Twitter</span></a></li>
      </ul>
    </div>
  </div>
</div>

{% if not contactInBio %}
<div class="info-section compact-section">
  <span class="section-label">Contact</span>
  {#- The visible address keeps the (at) spelling, but the href has to be a real
      mailto: for the click to work — so the address is in the markup either way. -#}
  <p class="contact-line"><a href="mailto:lastunen@wider.unu.edu">{{ linkIcon("mail") }}<span>Get in touch at lastunen(at)wider.unu.edu</span></a></p>
</div>
{% endif %}
